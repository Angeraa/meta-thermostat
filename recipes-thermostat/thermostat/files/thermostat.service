[Unit]
Description=My personal thermostat
Requires=mosquitto.service
After=mosquitto.service

[Service]
ExecStart=/usr/bin/Thermostat
# Runs as root, so it already has access to the DRM (/dev/dri) and input
# (/dev/input) devices. Retry so a crash or a not-yet-ready device recovers.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target